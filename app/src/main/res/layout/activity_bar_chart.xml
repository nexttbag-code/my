<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">



    <Button
        android:id="@+id/btnSelectYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2025"
        android:textAllCaps="false"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:backgroundTint="#E5E7EB"
        android:textColor="#111827"
        android:translationY="40dp"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <!-- ======================= -->
        <!-- 年份选择 -->
        <!-- ======================= -->



        <!-- 间距 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- ======================= -->
        <!-- 顶部统计模块 -->
        <!-- ======================= -->

        <!-- 大数字 -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1852.4 h"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#16A34A"
            android:textAlignment="center"
            android:gravity="center" />

        <!-- 副标题 -->
        <TextView
            android:id="@+id/tvTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="累计学习总时长"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:layout_marginTop="6dp"
            android:textAlignment="center" />

        <!-- 间距 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="36dp" />

        <!-- 日均 -->
        <TextView
            android:id="@+id/tvAvg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3h 14m / 天"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:textAlignment="center" />

        <!-- 坚持时间 -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="570 天 · 1.7 年"
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:layout_marginTop="6dp"
            android:textAlignment="center" />

        <!-- ======================= -->
        <!-- 分类模块 -->
        <!-- ======================= -->

        <!-- 上间距 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- ===== 学习 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvStudyLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="学习"
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvStudyHour"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="300 h"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvStudyPercent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="70%"
                android:textSize="15sp"
                android:textColor="#16A34A"
                android:gravity="center" />
        </LinearLayout>

        <!-- ===== 休息 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvRestLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="休息"
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvRestHour"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="100 h"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvRestPercent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="20%"
                android:textSize="15sp"
                android:textColor="#2563EB"
                android:gravity="center" />
        </LinearLayout>

        <!-- ===== 其他 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvOtherLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="其他"
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvOtherHour"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="50 h"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvOtherPercent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="10%"
                android:textSize="15sp"
                android:textColor="#9CA3AF"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

</ScrollView>