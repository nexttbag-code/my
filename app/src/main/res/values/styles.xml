<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/my_button_bg</item>
        <item name="android:textColor">@color/my_button_text</item>
        <item name="strokeColor">@color/my_button_stroke</item>
        <item name="strokeWidth">2dp</item>

    </style>
    <style name="ActivityButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">62dp</item> <!-- 降低高度 -->
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#0066CC</item>
        <item name="android:background">@drawable/btn_ios_light</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:gravity">center</item>
        <item name="iconTint">#007AFF</item>
        <item name="android:drawablePadding">8dp</item>
    </style>








</resources>
