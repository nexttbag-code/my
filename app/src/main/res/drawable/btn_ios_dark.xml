<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按下态（稍亮） -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4B5A6A"
                android:endColor="#3E4A57"
                android:angle="90" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#5A6B7C" />
        </shape>
    </item>

    <!-- 默认态 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#38424F"
                android:endColor="#2E3641"
                android:angle="90" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#4A5568" />
            <padding
                android:left="8dp"
                android:top="6dp"
                android:right="8dp"
                android:bottom="6dp" />
        </shape>
    </item>

</selector>
